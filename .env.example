# =================================================================
# ElectionDesk — Environment Configuration Template
# NOTE: Replace all placeholder values with managed production secrets.
# Never commit real credentials or private keys to source control.
# =================================================================

# Server Environment
NODE_ENV=production
PORT=5000

# Database Connectivity (MongoDB Atlas Private Endpoint / Isolated Replica Set)
# e.g., mongodb+srv://<app_user>:<strong_password>@cluster0.private.mongodb.net/electiondesk?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/electiondesk
USE_IN_MEMORY_DB=false

# JSON Web Token Secret Keys (Generate with: openssl rand -base64 48)
JWT_SECRET=REPLACE_WITH_HIGH_ENTROPY_RANDOM_SECRET_FOR_JWT_SESSION
JWT_EXPIRES_IN=8h
STEP_UP_JWT_SECRET=REPLACE_WITH_SEPARATE_HIGH_ENTROPY_RANDOM_SECRET_FOR_STEP_UP
COOKIE_SECRET=REPLACE_WITH_HIGH_ENTROPY_COOKIE_SIGNING_SECRET

# CORS Allowed Origin (Lock down to verified frontend domain)
CORS_ORIGIN=https://electiondesk.yourdomain.gov

# File Storage Configuration (Private object storage mount / volume)
STORAGE_DIR=/var/data/electiondesk/voter_photos

# Google Maps Platform API Key (Restricted to Places API & Geocoding with HTTP Referrer constraints)
GOOGLE_MAPS_API_KEY=AIzaSy_YOUR_RESTRICTED_GOOGLE_MAPS_API_KEY_HERE

# Rate Limiting Parameters
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
